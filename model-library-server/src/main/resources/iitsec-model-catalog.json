{
  "models": [
    {
      "modelId": "MissionArchitecture.Sim.MissionModel.InformationEnvironment.NetworkModel.CommunicationsNetwork",
      "name": "CommunicationsNetwork",
      "description": "DEVS atomic model representing a communications network that handles message routing and network connectivity based on system statuses and jammer commands.",
      "implementationLanguage": "Java",
      "inputPorts": [
        {
          "name": "messageIntoCommsNetwork",
          "direction": "input",
          "messageType": "Message",
          "description": "Receives messages to be routed through the network."
        },
        {
          "name": "statusToCommsNetwork",
          "direction": "input",
          "messageType": "SystemStatus",
          "description": "Receives system status updates to update network topology/connectivity."
        },
        {
          "name": "jammerCommandToCommsNetwork",
          "direction": "input",
          "messageType": "JammerCommand",
          "description": "Receives jammer commands that affect network connectivity."
        }
      ],
      "outputPorts": [
        {
          "name": "messageFromCommsNetwork",
          "direction": "output",
          "messageType": "Message",
          "description": "Emits messages that have been successfully routed through the network."
        },
        {
          "name": "networkConnectivityObservation",
          "direction": "output",
          "messageType": "NetworkConnectivity",
          "description": "Emits reports on the current connectivity state of the network."
        }
      ],
      "parameters": [
        {
          "name": "communicationsNetworks",
          "type": "CommunicationsNetworkInit[]",
          "required": true,
          "description": "Initial configuration for the communications networks."
        }
      ],
      "messageSchemas": {
        "Location": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude", "altitude"],
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "altitude": { "type": "number" }
          }
        },
        "Message": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": ["senderId", "receiverId", "messageId", "networkId", "messageType"],
          "properties": {
            "senderId": { "type": "string" },
            "receiverId": { "type": "string" },
            "messageId": { "type": "string" },
            "networkId": { "type": "string" },
            "messageType": { "type": "string" },
            "payload": {
              "type": "object",
              "properties": {
                "payloadId": { "type": "string" }
              }
            }
          }
        },
        "SystemStatus": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": ["systemId", "name", "fullName", "milStd2525Symbol", "location", "timeSeconds"],
          "properties": {
            "systemId": { "type": "string" },
            "name": { "type": "string" },
            "fullName": { "type": "string" },
            "milStd2525Symbol": { "type": "string" },
            "location": { "$ref": "#/components/schemas/Location" },
            "timeSeconds": { "type": "integer" }
          }
        },
        "JammerCommand": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": ["jammerId", "networkId", "jammerCommand"],
          "properties": {
            "jammerId": { "type": "string" },
            "networkId": { "type": "string" },
            "jammerCommand": { "type": "string", "enum": ["START_JAMMING", "STOP_JAMMING"] }
          }
        },
        "NetworkConnectivity": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": ["nodes", "matrix"],
          "properties": {
            "nodes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "matrix": {
              "type": "array",
              "items": { "type": "boolean" }
            }
          }
        },
        "CommunicationsNetworkInit": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": ["networkId", "radios"],
          "properties": {
            "networkId": { "type": "string" },
            "radios": {
              "type": "array",
              "items": { "$ref": "#/components/schemas/CommunicationsSystemInit" }
            },
            "jammers": {
              "type": "array",
              "items": { "$ref": "#/components/schemas/CommunicationsSystemInit" }
            }
          }
        },
        "CommunicationsSystemInit": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": ["platformId", "transmitPower", "location"],
          "properties": {
            "platformId": { "type": "string" },
            "transmitPower": { "type": "number" },
            "location": { "$ref": "#/components/schemas/Location" }
          }
        }
      },
      "initializationSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["communicationsNetworks"],
        "properties": {
          "communicationsNetworks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CommunicationsNetworkInit" }
          }
        }
      },
      "defaultParameterSet": {
        "communicationsNetworks": [
          {
            "networkId": "RAVEN-NET",
            "radios": [
              {
                "platformId": "tx-1",
                "transmitPower": 700000000.0,
                "location": {
                  "longitude": 16.6122166,
                  "latitude": 58.7439306,
                  "altitude": 0.0
                }
              },
              {
                "platformId": "rx-1",
                "transmitPower": 700000000.0,
                "location": {
                  "longitude": 16.6200613,
                  "latitude": 58.7453959,
                  "altitude": 0.0
                }
              }
            ],
            "jammers": [
              {
                "platformId": "jam-1",
                "transmitPower": 2000000000.0,
                "location": {
                  "longitude": 16.7264349,
                  "latitude": 58.7483263,
                  "altitude": 0.0
                }
              }
            ]
          }
        ]
      },
      "behaviorDescription": "CommunicationsNetwork simulates the propagation and interference of messages between radios, subject to geographical constraints and jamming.",
      "metadata": {
        "source": "model-library/open-api/iitsec-mission.sysml",
        "sysmlQualifiedName": "MissionArchitecture::Sim::MissionModel::InformationEnvironment::NetworkModel::CommunicationsNetwork",
        "stereotype": "DevsAtomicModel"
      }
    },
    {
